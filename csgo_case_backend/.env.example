# Backend environment configuration for csgo_case_backend

# Server
PORT=4000
APP_BASE_URL=http://localhost:4000

# CORS - must match your frontend dev origin
FRONTEND_ORIGIN=http://localhost:3000

# Sessions
SESSION_SECRET=dev-secret-change

# Database (SQLite by default)
# For local dev, Prisma package.json scripts default to file:./dev.db if unset.
DATABASE_URL="file:./dev.db"

# Steam OAuth (optional; leave unset to enable dev-login)
# STEAM_API_KEY=your_steam_web_api_key
# STEAM_REALM=http://localhost:4000
# STEAM_RETURN_TO=http://localhost:4000/auth/steam/return

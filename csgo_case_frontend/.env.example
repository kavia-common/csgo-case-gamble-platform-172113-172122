# Frontend environment configuration for csgo_case_frontend

# Backend REST base URL (must include protocol and port)
REACT_APP_API_BASE_URL=http://localhost:4000

# Steam OAuth settings for backend (optional)
# When Steam is NOT configured in backend, the Login button will still work by calling /auth/dev-login on the backend.
# If you configure Steam on the backend, you can pass realm and return_to via env here:
REACT_APP_STEAM_REALM=http://localhost:3000
REACT_APP_STEAM_RETURN_TO=http://localhost:3000/auth/callback

# App display name (optional)
REACT_APP_APP_NAME=Case Ocean
